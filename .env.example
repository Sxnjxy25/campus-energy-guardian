# SmartCampus Energy Guardian Environment Configuration
# Copy this file to .env before starting the application

# Application Mode
VITE_APP_ENV=development

# Server Configuration (Development server default port: 8080)
VITE_PORT=8080

# Telemetry & API Service URL (Leave blank for internal mock/demo stream)
VITE_API_BASE_URL=

# MQTT Broker Connection (Optional for live edge hardware connection)
VITE_MQTT_BROKER_URL=
VITE_MQTT_CLIENT_ID=campus_guardian_web_client
VITE_MQTT_TOPIC_PREFIX=campus/
